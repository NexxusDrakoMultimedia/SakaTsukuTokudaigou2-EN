-- fonttest.lua  (GENERATED by `python -I -X utf8 tools/fontpatch.py lua` from tools/emu/fonttest.lua.in; do not edit the .lua)
--
-- LIVE test of the proportional half-width font (docs/proportional-font.md s7).  It applies, into the RUNNING game's RAM,
-- exactly the bytes that tools/fontpatch.py writes into the disc image:
--   * the 104-byte advance/wrap routine and the 256-byte advance table in the 1ST_READ tail (CAVE / TABLE below)
--   * the half-width glyphs 0x21-0x7E (not the digits), left-aligned, in the font that FONT.BIN loaded to 0x8cd5c000
--   * H1 (advance) and H2 (wrap) hooks in every copy of the tsString layout function found in the overlay arena
-- It uses only the bridge helpers of tools/emu/live.lua (peek / poke / say) and flycast.memory.read32.  It does NOT press
-- any button, does not touch the disc and does not read or write any file.  Results go to build/emu/live.log via say().
--
-- How to run it (bridge already running: tools/emu/live.lua is Flycast's Lua script; you may use the game normally):
--   Windows PowerShell, from the project root:
--     "FONTTEST_MODE = 'prop'" | Set-Content build\emu\cmd.lua -Encoding ascii; Get-Content tools\emu\fonttest.lua | Add-Content build\emu\cmd.lua -Encoding ascii
--   (the bridge runs cmd.lua within ~20 frames and deletes it).  MODE is one of
--     'prop'     glyphs left-aligned + proportional table + H1 + H2   (the real thing)
--     'adv'      like 'prop' but without H2: lines still wrap after 39 cells (the conservative first test)
--     'fixed'    control: all advances 12 px, glyphs as in the original game, hooks installed: must look EXACTLY like the unpatched game
--     'restore'  put back the original glyphs and the original overlay bytes this script replaced (the cave stays, it is inert)
--     'status'   only report what is patched
--   Add  FONTTEST_WATCH = true  (first line of cmd.lua) to re-scan every ~4 s and hook overlays that were loaded since (hitches the
--   frame rate while scanning).  Text that is ALREADY on screen keeps its old glyph textures: leave the screen and enter it again.
--
-- UNPROVEN: whether flycast.memory.write8 invalidates the dynarec's translated blocks; if the open screen does not change at all
-- after 'prop', switch Flycast's CPU mode to the interpreter (or leave and re-enter the screen after the hook has been written).
local MODE = rawget(_G, "FONTTEST_MODE") or "prop"
local WATCH = rawget(_G, "FONTTEST_WATCH") and true or false

--@@DATA@@

local ARENA_LO, ARENA_HI = 0x8c2d0000, 0x8cd5c000    -- overlay arena (slots); FONT.BIN follows at 0x8cd5c000
local GLYPH_BYTES = 144

local function log(m) if say then say("fonttest: " .. tostring(m)) end end
local function unhex(s) return (s:gsub("%x%x", function(h) return string.char(tonumber(h, 16)) end)) end
local function hex(s) return (s:gsub(".", function(c) return string.format("%02x", c:byte()) end)) end
local function rd(a, n)
  if peek then return peek(a, n) end
  local t = {}
  for i = 0, n - 1 do t[#t + 1] = string.char(flycast.memory.read8(a + i)) end
  return table.concat(t)
end
local function wr(a, s)
  if poke then poke(a, s) return end
  for i = 1, #s do flycast.memory.write8(a + i - 1, s:byte(i)) end
end
local function le32(s) local a, b, c, d = s:byte(1, 4); return a + b * 256 + c * 65536 + d * 16777216 end

local FT = rawget(_G, "__fonttest") or { saved = {}, sites = {}, installed = false }
_G.__fonttest = FT
FT.mode, FT.watch = MODE, WATCH

-- remember the ORIGINAL bytes of everything we overwrite (first time only), for 'restore'
local function save(a, n)
  local k = string.format("%08x", a)
  if FT.saved[k] == nil then FT.saved[k] = rd(a, n) end
end

-- 1. cave + table ------------------------------------------------------------------------------------------------------------
local function put_cave_and_table(tbl_hex)
  local cave = unhex(CAVE_HEX)
  local cur = rd(CAVE, #cave)
  if cur ~= cave then
    if rd(CAVE, 0x100) ~= string.rep("\0", 0x100) then
      log("ABORT: cave area " .. string.format("%08x", CAVE) .. " is neither zero nor our cave; not touching it")
      return false
    end
    wr(CAVE, cave)
  end
  local tcur = rd(TABLE, 256)
  if tcur ~= string.rep("\0", 256) and FT.tablewritten ~= true and tcur ~= unhex(TABLE_HEX) and tcur ~= unhex(FIXED_HEX) then
    log("ABORT: table area " .. string.format("%08x", TABLE) .. " is not zero and not our table; not touching it")
    return false
  end
  wr(TABLE, unhex(tbl_hex))
  FT.tablewritten = true
  return true
end

-- 2. glyph art ---------------------------------------------------------------------------------------------------------------
local function put_glyphs(which)   -- which = "new" (left aligned) or "old"
  local src = (which == "new") and GLYPH_NEW or GLYPH_OLD
  local n, bad = 0, 0
  for b, idx in pairs(HALF_IDX) do
    local a = HALF_BASE + idx * GLYPH_BYTES
    local cur = hex(rd(a, GLYPH_BYTES))
    if cur == GLYPH_NEW[b] or cur == GLYPH_OLD[b] then
      if cur ~= src[b] then wr(a, unhex(src[b])) end
      n = n + 1
    else
      bad = bad + 1
    end
  end
  log("glyphs " .. which .. ": " .. n .. " slots written/confirmed, " .. bad .. " slots did not match the expected font (skipped)")
  return n, bad
end

-- 3. hooks in the overlay arena ---------------------------------------------------------------------------------------------
local function scan_arena()
  local found = {}
  local wA, wB = le32(unhex(VARIANTS.A.h1_old)), le32(unhex(VARIANTS.B.h1_old))
  local wAn = le32(unhex(VARIANTS.A.h1_new))
  local r32 = flycast.memory.read32
  for a = ARENA_LO, ARENA_HI - 16, 4 do
    local w = r32(a) & 0xffffffff
    if w == wA or w == wB or w == wAn then
      local s = rd(a, 16)
      for v, t in pairs(VARIANTS) do
        local old, new = unhex(t.h1_old), unhex(t.h1_new)
        if s == old or s == new then
          local h2 = a - t.h2_back
          local o2, n2 = unhex(t.h2_old), unhex(t.h2_new)
          local c2 = rd(h2, #o2)
          if c2 == o2 or c2 == n2 then
            found[#found + 1] = { v = v, h1 = a, h2 = h2, t = t }
          end
        end
      end
    end
  end
  return found
end

local function put_hooks(sites, with_wrap)
  local n1, n2 = 0, 0
  for _, s in ipairs(sites) do
    local t = s.t
    save(s.h1, 16)
    save(s.h2, #unhex(t.h2_old))
    wr(s.h1, unhex(t.h1_new)); n1 = n1 + 1
    if with_wrap then wr(s.h2, unhex(t.h2_new)); n2 = n2 + 1
    else wr(s.h2, unhex(t.h2_old)) end
    -- remember what we wrote so 'restore' never overwrites a different overlay that now occupies the slot
    FT.written = FT.written or {}
    FT.written[string.format("%08x", s.h1)] = rd(s.h1, 16)
    FT.written[string.format("%08x", s.h2)] = rd(s.h2, #unhex(t.h2_old))
  end
  return n1, n2
end

local function restore_hooks()
  local n = 0
  local skipped = 0
  for k, v in pairs(FT.saved) do
    local a = tonumber(k, 16)
    local w = FT.written and FT.written[k]
    if w ~= nil and rd(a, #v) == w then
      wr(a, v); n = n + 1
    elseif w ~= nil and rd(a, #v) == v then
      n = n + 1                       -- already original
    else
      skipped = skipped + 1           -- foreign bytes (overlay changed) or unknown: do not touch
    end
  end
  if skipped > 0 then log("restore skipped " .. skipped .. " ranges whose RAM no longer holds our patch (overlay changed)") end
  return n
end

local function main()
  log("mode=" .. MODE .. " watch=" .. tostring(WATCH))
  if MODE == "status" then
    local sites = scan_arena()
    local pat = 0
    for _, s in ipairs(sites) do if rd(s.h1, 16) == unhex(s.t.h1_new) then pat = pat + 1 end end
    log("status: " .. #sites .. " layout functions in the arena, " .. pat .. " hooked; cave " ..
        ((rd(CAVE, 104) == unhex(CAVE_HEX)) and "present" or "absent") .. "; table first bytes " .. hex(rd(TABLE, 8)))
    return
  end
  if MODE == "restore" then
    put_glyphs("old")
    log("restored " .. restore_hooks() .. " saved ranges (cave and table left in place)")
    return
  end
  if MODE ~= "prop" and MODE ~= "adv" and MODE ~= "fixed" then log("unknown MODE " .. MODE); return end
  if not put_cave_and_table(MODE == "fixed" and FIXED_HEX or TABLE_HEX) then return end
  put_glyphs(MODE == "fixed" and "old" or "new")
  local sites = scan_arena()
  FT.sites = sites
  local n1, n2 = put_hooks(sites, MODE ~= "adv")
  local names = {}
  for _, s in ipairs(sites) do names[#names + 1] = s.v .. "@" .. string.format("%08x", s.h1) end
  log("hooked " .. n1 .. " advance sites and " .. n2 .. " wrap sites: " .. table.concat(names, " "))
  if n1 == 0 then log("no layout function found in the arena (open a screen with text first, then run this again)") end
end

local ok, err = pcall(main)
if not ok then log("ERROR " .. tostring(err)) end

-- optional watcher: wraps the bridge's vblank handler once, re-hooks newly loaded overlays every ~240 frames
if WATCH and not FT.installed and flycast_callbacks then
  FT.installed = true
  local prev = flycast_callbacks.vblank
  local k = 0
  flycast_callbacks.vblank = function()
    if prev then prev() end
    k = k + 1
    if FT.watch and k % 240 == 0 and FT.mode ~= "restore" and FT.mode ~= "status" then
      local sites = scan_arena()
      local fresh = {}
      for _, s in ipairs(sites) do if rd(s.h1, 16) ~= unhex(s.t.h1_new) then fresh[#fresh + 1] = s end end
      if #fresh > 0 then
        local n1 = put_hooks(fresh, FT.mode ~= "adv")
        log("watch: hooked " .. n1 .. " newly loaded layout function(s)")
      end
    end
  end
  log("watcher installed")
end
